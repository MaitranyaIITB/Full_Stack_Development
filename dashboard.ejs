<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Dashboard</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
  <div class="container mt-5">
    <div class="card shadow p-4">
      <h2 class="text-primary">Welcome to your Dashboard<% if (username) { %>, <%= username %><% } %>!</h2>
      <p class="text-muted">Choose an action below:</p>

      <ul class="list-group list-group-flush mb-4">
        <li class="list-group-item"><a href="/list-products" class="text-decoration-none"> List Products</a></li>
        <li class="list-group-item"><a href="/add-to-cart" class="text-decoration-none"> Add to Cart</a></li>
        <li class="list-group-item"><a href="/remove-from-cart" class="text-decoration-none"> Remove from Cart</a></li>
        <li class="list-group-item"><a href="/display-cart" class="text-decoration-none">View Cart</a></li>
        <li class="list-group-item"><a href="/logout" class="text-danger text-decoration-none"> Logout</a></li>
      </ul>

    </div>
  </div>
</body>
</html>
